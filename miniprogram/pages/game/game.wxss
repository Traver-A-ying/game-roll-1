:root {
  --bg: #16182a;
  --card: #1f2238;
  --card-deep: #232743;
  --accent: #f5c84b;
  --accent-2: #ff6b86;
  --text: #f2f5ff;
  --muted: #9aa0ba;
  --border: rgba(255, 255, 255, 0.08);
}

.page {
  max-width: 880px;
  margin: 0 auto;
  padding: 48px 24px 64px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.hero {
  padding-bottom: 24px;
  border-bottom: 1px dashed var(--border);
}

.hero-title {
  display: flex;
  align-items: center;
  gap: 16px;
}

.hero-icon {
  font-size: 32px;
  color: var(--accent);
  background: rgba(245, 200, 75, 0.16);
  padding: 12px 14px;
  border-radius: 16px;
}

.title {
  font-size: 36px;
  letter-spacing: 1px;
  font-weight: 700;
  display: block;
}

.subtitle {
  color: var(--muted);
  margin-top: 6px;
  font-size: 16px;
  letter-spacing: 1px;
  display: block;
}

.card {
  background: linear-gradient(160deg, rgba(37, 40, 70, 0.9), rgba(22, 24, 42, 0.9));
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 24px;
  box-shadow: 0 16px 30px rgba(0, 0, 0, 0.25);
}

.section-title {
  font-size: 22px;
  margin-bottom: 16px;
  display: block;
  font-weight: 600;
}

.rules {
  display: grid;
  gap: 12px;
  padding-left: 16px;
  color: var(--text);
}

.bonus-table {
  display: grid;
  gap: 12px;
}

.bonus-row {
  display: grid;
  grid-template-columns: 120px 120px 1fr;
  align-items: center;
  padding: 12px 16px;
  background: var(--card);
  border-radius: 14px;
  border: 1px solid var(--border);
  gap: 8px;
}

.bonus-tag {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 6px 14px;
  border-radius: 999px;
  font-weight: 600;
  color: #111222;
}

.tag-red {
  background: linear-gradient(135deg, #ff6b86, #ffb86b);
}

.tag-gold {
  background: linear-gradient(135deg, #f5c84b, #ffdf7e);
}

.tag-green {
  background: linear-gradient(135deg, #74e071, #44c78a);
}

.tag-blue {
  background: linear-gradient(135deg, #46d4e0, #7be5f4);
}

.warning {
  background: linear-gradient(135deg, rgba(255, 130, 72, 0.2), rgba(255, 76, 76, 0.16));
  border: 1px solid rgba(255, 120, 120, 0.35);
  padding: 16px;
  border-radius: 16px;
  margin-bottom: 12px;
  display: grid;
  gap: 8px;
}

.warning-title {
  font-weight: 700;
}

.highlight {
  color: var(--accent);
  font-weight: 700;
}

.muted,
.note {
  color: var(--muted);
  font-size: 14px;
  margin-top: 8px;
}

.play-area {
  display: grid;
  gap: 18px;
}

.dice-visual {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
  min-height: 72px;
}

.die {
  width: 64px;
  height: 64px;
  border-radius: 16px;
  background: linear-gradient(145deg, #2b2f4d, #1b1e35);
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: grid;
  place-items: center;
  font-size: 24px;
  font-weight: 700;
  color: var(--accent);
  box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.06), 0 12px 20px rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease;
}

.die.rolling {
  animation: dice-roll 0.6s infinite linear;
  color: #ffffff;
  text-shadow: 0 0 10px rgba(123, 240, 255, 0.6);
}

@keyframes dice-roll {
  0% {
    transform: rotate(0deg) scale(1);
  }
  50% {
    transform: rotate(180deg) scale(1.08);
  }
  100% {
    transform: rotate(360deg) scale(1);
  }
}

.controls {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

button {
  border-radius: 12px;
  font-size: 16px;
  padding: 10px 18px;
  line-height: 1.4;
}

.primary {
  background: linear-gradient(135deg, #f5c84b, #ffd56b);
  color: #1b1b1b;
  font-weight: 600;
}

.secondary {
  background: linear-gradient(135deg, #7bf0ff, #57b9ff);
  color: #0f172a;
  font-weight: 600;
}

.ghost {
  background: transparent;
  color: var(--muted);
  border: 1px solid var(--border);
}

.status {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
}

.label {
  color: var(--muted);
  font-size: 14px;
  display: block;
}

.value {
  font-size: 28px;
  margin-top: 4px;
  font-weight: 700;
  display: block;
}

.dice-log {
  background: var(--card-deep);
  border-radius: 16px;
  padding: 16px;
  border: 1px dashed var(--border);
}

.log-title {
  display: block;
  font-weight: 600;
}

.log {
  margin-top: 12px;
  display: grid;
  gap: 10px;
  color: var(--muted);
  font-size: 14px;
}

.log-entry {
  display: flex;
  justify-content: space-between;
  background: rgba(17, 20, 40, 0.6);
  padding: 10px 12px;
  border-radius: 10px;
  gap: 12px;
}

.footer {
  text-align: center;
  color: var(--accent);
  font-weight: 700;
  font-size: 20px;
  padding-top: 12px;
}

@media (max-width: 640px) {
  .bonus-row {
    grid-template-columns: 1fr;
  }

  .hero-title {
    flex-direction: column;
    align-items: flex-start;
  }
}
